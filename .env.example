# Copy to .env (never commit .env). In production the file lives at /opt/papa/.env.
# Rule: any variable read by the code or referenced by the compose files must be here.
# `infra/check-env-example.sh` (also in CI) fails if one is missing.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://papa:papa@localhost:5432/papa
# Production Postgres password (infra/docker-compose.prod.yml requires it).
# WARNING: change it BEFORE the first `up`. Postgres only reads this variable when it
# initialises the volume; changing it later does not change the real password and forces
# recreating /opt/papa/pgdata.
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
# Engine User-Agent. Commented out = the identified default "PapaRentBot/0.1 (+https://example.com/bot)".
# Set it to your own bot name and a contact URL; robots.txt groups are matched on the
# product token (the part before "/"). An empty value also falls back to the default.
# BOT_USER_AGENT=
# Registry path. Commented out = resolves to the repository's docs/sources/registry.yaml.
# REGISTRY_PATH=
# Engine (optional): concurrency, minimum gap per host, enrichment queue
ENGINE_CONCURRENCY=4
# At least 60 s between two requests to the same host (source policy).
ENGINE_MIN_GAP_PER_HOST_MS=60000
ENGINE_REQUEST_TIMEOUT_MS=30000
ENGINE_ENRICH_GAP_MS=10000
ENGINE_ENRICH_QUEUE_MAX=300
ENGINE_GEOCODE=1
ENGINE_GEOCODE_GAP_MS=250
ENGINE_GEOCODE_BACKFILL_MS=1800000
# Visitor-like load: each request of a poll costs this much in the next interval (6 pages → ≥ 6 min)
ENGINE_PER_REQUEST_BUDGET_MS=60000
# Browser for Tier B sources (`render` plans); empty = look for chromium on the system
ENGINE_BROWSER_EXECUTABLE=
ENGINE_BROWSER_ARGS=--no-sandbox,--disable-dev-shm-usage
ENGINE_BROWSER_TIMEOUT_MS=45000

# Optional: only used by llm-extract adapters (unstructured sources)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# In production the engine refuses to start without this key (silent loss of alerts).
RESEND_API_KEY=
EMAIL_FROM="PAPA RENT <alerts@example.com>"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.example.com
# Domain served by Caddy (TLS certificate). Must point at the VPS IP.
API_DOMAIN=api.example.com
APP_SCHEME=paparent
WEB_URL=https://app.example.com
# Require a verified email before the first login. Empty/0 = off (ADR-002, onboarding ≤ 90 s).
# The verification path is implemented and works with REQUIRE_EMAIL_VERIFICATION=1.
REQUIRE_EMAIL_VERIFICATION=
WEB_ORIGINS=https://app.example.com
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.example.paparent
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# App (Expo) · read at client BUILD time, not by the server
# A build without these points at http://localhost:3000 and does not talk to production.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_WEB_URL=https://app.example.com
# Social providers shown on login, comma-separated: apple,google (empty = email+password only)
EXPO_PUBLIC_SOCIAL=
# Only needed when the EAS project does not come from app.json (extra.eas.projectId)
EXPO_PUBLIC_EAS_PROJECT_ID=

# ---------------------------------------------------------------------------
# Backup (infra/backup.sh, daily systemd timer on the VPS)
# ---------------------------------------------------------------------------
# rclone remote destination. Empty = local-only backup, and the log says so on every run.
# When set, an upload failure makes the backup fail (never silently).
BACKUP_REMOTE=
# Backblaze B2 credentials through rclone itself (no config file):
# BACKUP_REMOTE=b2:papa-rent-backups requires a remote named `b2` → RCLONE_CONFIG_B2_*.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
# Retention in days for the local dumps in /opt/papa/backups
BACKUP_RETENTION_DAYS=14
# Where the alert goes when a run fails (uses RESEND_API_KEY/EMAIL_FROM).
# Empty = the alert stays in the journal only (`journalctl -u papa-backup`).
ALERT_EMAIL=

# Optional static prototype export; production/native builds leave this off.
EXPO_PUBLIC_DEMO=0
PAPA_WEB_BASE_PATH=
