{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.schema.json",
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "node": "22.12.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3000",
        "EXPO_PUBLIC_SOCIAL": ""
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "node": "22.12.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.example.com",
        "EXPO_PUBLIC_WEB_URL": "https://example.com",
        "EXPO_PUBLIC_SOCIAL": ""
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "node": "22.12.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.example.com",
        "EXPO_PUBLIC_WEB_URL": "https://example.com",
        "EXPO_PUBLIC_SOCIAL": ""
      },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "REPLACE_ME-apple-id-email",
        "ascAppId": "REPLACE_ME-app-store-connect-app-id",
        "appleTeamId": "REPLACE_ME-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "appleId": "REPLACE_ME-apple-id-email",
        "ascAppId": "REPLACE_ME-app-store-connect-app-id",
        "appleTeamId": "REPLACE_ME-apple-team-id"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/google-play-service-account.json",
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    }
  }
}
